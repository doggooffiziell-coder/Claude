; Engine configuration file.
; Ant Pop: Ameisenkolonie im Formicarium.

config_version=5

[application]

config/name="Ant Pop"
config/description="Ameisenkolonie-Simulation im Querschnitt durch den Boden."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=270
window/size/viewport_height=480
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.06, 0.16, 0.1, 1)
