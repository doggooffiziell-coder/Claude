static var _font: FontFile


static func font() -> FontFile:
	if _font != null:
		return _font
	var cell_w := 6
	var cell_h := ASCENT + DESCENT
	var per_row := 16
	var keys := GLYPHS.keys()
	var atlas_rows := int(ceil(float(keys.size()) / per_row))
	var atlas := Image.create_empty(per_row * cell_w, atlas_rows * cell_h, false, Image.FORMAT_RGBA8)
	var f := FontFile.new()
	f.antialiasing = TextServer.FONT_ANTIALIASING_NONE
	f.generate_mipmaps = false
	f.fixed_size = SIZE
	f.fixed_size_scale_mode = TextServer.FIXED_SIZE_SCALE_INTEGER_ONLY
	f.subpixel_positioning = TextServer.SUBPIXEL_POSITIONING_DISABLED
	f.hinting = TextServer.HINTING_NONE
	var size := Vector2i(SIZE, 0)
	f.set_cache_ascent(0, SIZE, ASCENT + 1)
	f.set_cache_descent(0, SIZE, DESCENT + 1)
	var glyph_rects := {}
	for i in keys.size():
		var ch: String = keys[i]
		var rows: Array = GLYPHS[ch]
		var gw: int = rows[0].length()
		var ax := (i % per_row) * cell_w
		var ay := (i / per_row) * cell_h
		for ry in rows.size():
			var line: String = rows[ry]
			for rx in line.length():
				if line[rx] == "#":
					atlas.set_pixel(ax + rx, ay + ry, Color.WHITE)
		glyph_rects[ch] = [Rect2(ax, ay, gw, cell_h), gw]
	f.set_texture_image(0, size, 0, atlas)
	for ch in glyph_rects:
		var cp: int = ch.unicode_at(0)
		var r: Rect2 = glyph_rects[ch][0]
		var gw: int = glyph_rects[ch][1]
		f.set_glyph_advance(0, SIZE, cp, Vector2(gw + 1, 0))
		f.set_glyph_offset(0, size, cp, Vector2(0, -ASCENT))
		f.set_glyph_size(0, size, cp, Vector2(gw, cell_h))
		f.set_glyph_uv_rect(0, size, cp, r)
		f.set_glyph_texture_idx(0, size, cp, 0)
	# Leerzeichen
	f.set_glyph_advance(0, SIZE, 32, Vector2(3, 0))
	f.set_glyph_offset(0, size, 32, Vector2.ZERO)
	f.set_glyph_size(0, size, 32, Vector2.ZERO)
	f.set_glyph_uv_rect(0, size, 32, Rect2())
	f.set_glyph_texture_idx(0, size, 32, -1)
	_font = f
	return f


## Text als Maske, jedes Schriftpixel wird zu scale x scale Pixeln. Für große Titel mit eigener Kante.
static func text_mask(text: String, scale: int) -> Image:
	var width := 0
	for ch in text:
		width += (3 if ch == " " else (GLYPHS[ch][0] as String).length() + 1) if (ch == " " or GLYPHS.has(ch)) else 4
	var img := Image.create_empty(width * scale, (ASCENT + DESCENT) * scale, false, Image.FORMAT_RGBA8)
	var x := 0
	for ch in text:
		if ch == " " or not GLYPHS.has(ch):
			x += 3
			continue
		var rows: Array = GLYPHS[ch]
		for ry in rows.size():
			var line: String = rows[ry]
			for rx in line.length():
				if line[rx] == "#":
					img.fill_rect(Rect2i((x + rx) * scale, ry * scale, scale, scale), Color.WHITE)
		x += (rows[0] as String).length() + 1
	return img
